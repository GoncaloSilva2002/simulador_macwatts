{
  "name": "macwatts-simulador-node",
  "version": "1.0.0",
  "description": "Simulador MacWatts em Node.js",
  "main": "src/server.js",
  "scripts": {
    "build": "node scripts/build-amplify.js",
    "check": "node --check src/app.js && node --check src/server.js && node --check src/lambda.js && node --check src/services/quoteEmailService.js && node --check src/services/quotePdfService.js && node --check src/services/supabaseSimulationService.js",
    "package:lambda": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-lambda.ps1",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@sparticuz/chromium": "^147.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^25.12.0"
  }
}
